#!/usr/bin/env bash
set -euo pipefail
NODE_VERSION=$(sed -n 's/^ARG NODE_VERSION=//p' Dockerfile)
work=$(mktemp -d)
image="red-runtime-test:${GITHUB_RUN_ID:-local}-$$"
trap 'docker image rm "$image" >/dev/null 2>&1 || true; rm -rf "$work"' EXIT
python3 test/provenance.py
# A pristine source copy exposes skipped private/source-dependent tests honestly.
docker run --rm -v "$PWD/app":/src:ro -v "$work":/output -w /work \
  -e OUTPUT_UID="$(id -u)" -e OUTPUT_GID="$(id -g)" \
  "node:${NODE_VERSION}-alpine" sh -ec '
    cp -r /src/. /work
    npm ci --no-audit --no-fund
    npm run typecheck
    npm test
    npm run build
    cp -r dist /output/
    chmod -R a+rX /output
    # Return bind-mounted output to the runner so its EXIT trap can remove it.
    chown -R "$OUTPUT_UID:$OUTPUT_GID" /output
  '
# Build only the actual runtime stage. The workflow builds the final multiarch image.
docker build --target runtime-base -t "$image" .
python3 test/runtime.py --image "$image" --site "$work/dist"
